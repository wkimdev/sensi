# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/sensi_db"

# JWT Configuration
JWT_SECRET="your-very-secret-key-change-in-production-min-32-chars"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
